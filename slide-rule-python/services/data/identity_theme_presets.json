{
  "$comment": "8 套身份主题预设 + 生成主题合格契约的单一真相源（style-dictionary 单源多端思路）。前端 identity-themes.ts 经 @identity-themes alias 直读构建 THEMES 与 isValidGeneratedTheme；Python freeform_block.py 派生色板提示与生成主题使用判定，identity_theme_gen.py 派生格式正则。改这一份，各端同步；此前 Python 侧手抄色板+8 键弱校验与前端 11 项严校验错配，正是『卡片配色与侧栏对不上』的错配窗口。",
  "version": 1,
  "defaultThemeId": "azure",
  "generatedThemeContract": {
    "$comment": "生成主题（appIdentity.generatedTheme）的合格判定，两端同源：hexKeys 逐键 6 位十六进制；sidebarBg 允许纯色或两段式线性渐变；charts 恰好 chartsLength 个十六进制色。任何一项不满足即整套弃用、回落预设。",
    "hexPattern": "^#[0-9a-fA-F]{6}$",
    "sidebarBgGradientPattern": "^linear-gradient\\(\\s*(\\d{1,3})deg\\s*,\\s*(#[0-9a-fA-F]{6})\\s*,\\s*(#[0-9a-fA-F]{6})\\s*\\)$",
    "hexKeys": ["primary", "primaryHover", "gradTo", "primaryFg", "contentBg", "accentBg", "accentFg", "sidebarText"],
    "chartsLength": 3,
    "requiredKeys": ["primary", "primaryHover", "gradTo", "primaryFg", "contentBg", "accentBg", "accentFg", "sidebarText", "sidebarBg", "charts"]
  },
