  "blocks": [
    {
      "type": "MetricGrid",
      "description": "一组关键指标卡，用于页面摘要区域。",
      "rendererKey": "metric-grid",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          }
        }
      },
      "dataKinds": [
        "aggregate"
      ],
      "pageKinds": [
        "workbench",
        "dashboard",
        "monitor"
      ],
      "allowedSlots": [
        "summary",
        "primary"
      ],
      "slotsRationale": "NOT secondary or activity/content: a KPI row is several stat cards side by side, so the one-third-width column wraps them into an unreadable stack, and KPIs are the first thing the user scans — placing them below the page content defeats that.",
      "events": [
        "metricSelect"
      ],
      "bindingSchema": {
        "required": [
          "entityRef"
        ],
        "optional": [
          "aggregate",
          "filter"
        ],
        "aggregateFields": [
          "aggregate"
        ]
      },
      "capability": "aggregate"
    },
    {
      "type": "TrendChart",
      "description": "按时间或有序维度展示变化趋势。",
      "rendererKey": "trend-chart",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "surface": {
            "type": "string",
            "enum": [
              "card",
              "plain"
            ]
          }
        }
      },
      "dataKinds": [
        "series"
      ],
      "pageKinds": [
        "dashboard",
        "monitor"
      ],
      "allowedSlots": [
        "primary",
        "secondary"
      ],
      "slotsRationale": "NOT summary or activity/content: a chart needs a solid drawing area, which the top wrapping row cannot give it; and a trend belongs with the overview above the detail rows, not underneath them.",
      "events": [
        "pointSelect"
      ],
      "bindingSchema": {
        "required": [
          "entityRef",
          "timeDimensionRef"
        ],
        "optional": [
          "timeGrain",
          "seriesBy"
        ],
        "enums": {
          "timeGrain": [
            "day",
            "week",
            "month"
          ]
        },
        "entityFieldRefs": {
          "timeDimensionRef": "date",
          "seriesBy": "enum"
        }
      },
      "capability": "series"
    },
    {
      "type": "RankedList",
      "description": "按数值排序的业务排行。",
      "rendererKey": "ranked-list",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
