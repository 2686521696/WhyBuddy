  "blocks": [
    {
      "type": "MetricGrid",
      "description": "一组关键指标卡，用于页面摘要区域。",
      "rendererKey": "metric-grid",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          }
        }
      },
      "dataKinds": [
        "aggregate"
      ],
      "pageKinds": [
        "workbench",
        "dashboard",
        "monitor"
      ],
      "allowedRegions": [
        "metrics",
        "headerExtra",
        "aside"
      ],
      "regionsRationale": "仪表盘用全宽的 metrics（IntroduceRow 那一排）；列表/详情页用 headerExtra（页头右侧两三个数，不占正文）。不进 main——指标一旦占了主区，用户真正来看的那张表就被挤下去一屏。",
      "events": [
        "metricSelect"
      ],
      "bindingSchema": {
        "required": [
          "entityRef"
        ],
        "optional": [
          "aggregate",
          "filter"
        ],
        "aggregateFields": [
          "aggregate"
        ]
      },
      "capability": "aggregate",
      "family": "data"
    },
    {
      "type": "TrendChart",
      "description": "按时间或有序维度展示变化趋势。",
      "rendererKey": "trend-chart",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "surface": {
            "type": "string",
            "enum": [
              "card",
              "plain"
            ]
          }
        }
      },
      "dataKinds": [
        "series"
      ],
      "pageKinds": [
        "dashboard",
        "monitor"
      ],
      "allowedRegions": [
        "charts",
        "main",
        "aside"
      ],
      "regionsRationale": "趋势图要横向空间才看得出走势，charts 与 main 都够；aside 放迷你趋势也成立（DashboardWorkplace 的 Radar 就在右栏）。不进页头带——页头是给数字和操作的，塞张图会把标题挤成两行。",
      "events": [
        "pointSelect"
      ],
      "bindingSchema": {
        "required": [
          "entityRef",
          "timeDimensionRef"
        ],
        "optional": [
          "timeGrain",
          "seriesBy"
        ],
        "enums": {
          "timeGrain": [
            "day",
            "week",
            "month"
          ]
        },
        "entityFieldRefs": {
          "timeDimensionRef": "date",
          "seriesBy": "enum"
        }
      },
      "capability": "series",
      "family": "data"
    },
