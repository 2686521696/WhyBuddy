  "blocks": [
    {
      "type": "MetricGrid",
      "description": "一组关键指标卡，用于页面摘要区域。",
      "rendererKey": "metric-grid",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          }
        }
      },
      "dataKinds": [
        "aggregate"
      ],
      "allowedSlots": [
        "summary",
        "primary"
      ],
      "slotsRationale": "NOT secondary or activity/content: a KPI row is several stat cards side by side, so the one-third-width column wraps them into an unreadable stack, and KPIs are the first thing the user scans — placing them below the page content defeats that.",
      "events": [
        "metricSelect"
      ],
      "bindingSchema": {
        "required": [
          "entityRef"
        ],
        "optional": [
          "aggregate",
          "filter"
        ],
        "aggregateFields": [
          "aggregate"
        ]
      }
    },
    {
      "type": "TrendChart",
      "description": "按时间或有序维度展示变化趋势。",
      "rendererKey": "trend-chart",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          }
        }
      },
      "dataKinds": [
        "series"
      ],
      "allowedSlots": [
        "primary",
        "secondary"
      ],
      "slotsRationale": "NOT summary or activity/content: a chart needs a solid drawing area, which the top wrapping row cannot give it; and a trend belongs with the overview above the detail rows, not underneath them.",
      "events": [
        "pointSelect"
      ],
      "bindingSchema": {
        "required": [
          "entityRef",
          "timeDimensionRef"
        ],
        "optional": [
          "timeGrain",
          "seriesBy"
        ],
        "enums": {
          "timeGrain": [
            "day",
            "week",
            "month"
          ]
        },
        "entityFieldRefs": {
          "timeDimensionRef": "date",
          "seriesBy": "enum"
        }
      }
    },
    {
      "type": "RankedList",
      "description": "按数值排序的业务排行。",
      "rendererKey": "ranked-list",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          }
        }
      },
      "dataKinds": [
        "rankedRows"
      ],
      "allowedSlots": [
        "primary",
        "secondary"
      ],
      "slotsRationale": "NOT summary or activity/content: a Top-N is a vertical list and needs column height, which the top wrapping row has none of.",
      "events": [
        "itemSelect"
      ],
      "bindingSchema": {
        "required": [
          "entityRef",
          "sortByRef"
        ],
        "optional": [
          "sortOrder",
          "limit"
        ],
        "enums": {
          "sortOrder": [
            "asc",
            "desc"
          ]
        },
        "entityFieldRefs": {
          "sortByRef": "number"
        },
        "ranges": {
          "limit": [
            3,
            20
          ]
        }
      }
    },
    {
      "type": "ActivityFeed",
      "description": "按时间倒序展示动态、提醒或风险事件。",
      "rendererKey": "activity-feed",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "variant": {
            "type": "string",
            "enum": [
              "timeline",
              "row"
            ]
          }
        }
      },
      "dataKinds": [
        "timelineRows"
      ],
      "allowedSlots": [
        "activity",
        "secondary",
        "primary",
        "content"
      ],
      "slotsRationale": "NOT summary: a feed is a vertical list of entries; the top row is a horizontal wrapping strip and cannot hold it.",
      "events": [
        "itemSelect"
      ],
      "bindingSchema": {
        "required": [
          "entityRef",
          "timeFieldRef"
        ],
        "optional": [
          "levelFieldRef",
          "detailFieldRefs"
        ],
        "entityFieldRefs": {
          "timeFieldRef": "date",
          "levelFieldRef": "enum"
        },
        "entityFieldRefLists": {
          "detailFieldRefs": {
            "maxItems": 3,
            "note": "宽行档（variant=row）中段展示的明细字段，同实体下任意类型"
          }
        }
      }
    },
    {
      "type": "DataTable",
      "description": "展示实体记录并承接行级业务操作。",
      "rendererKey": "data-table",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          }
        }
      },
      "dataKinds": [
        "entityRows"
      ],
      "allowedSlots": [
        "primary",
        "content",
        "activity"
      ],
      "slotsRationale": "NOT summary or secondary: a table needs width for its columns — the one-third column squeezes them together, and the top wrapping row cannot hold a table at all.",
      "events": [
        "rowSelect",
        "createRequest",
        "editRequest"
      ],
      "bindingSchema": {
        "required": [
          "entityRef"
        ],
        "optional": [],
        "note": "其余列由页面 columns 派生；binding 对象整体可省略，省略时不受 required 约束。"
      }
    },
    {
      "type": "QuickActionPanel",
      "description": "CRM/任务工作台的快捷业务操作按钮组，适合工作台首页的常用动作入口。",
      "rendererKey": "quick-action-panel",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "columns": {
            "type": "number",
            "minimum": 1,
            "maximum": 4
          }
        }
      },
      "dataKinds": [],
      "allowedSlots": [
        "summary",
        "primary"
      ],
      "slotsRationale": "NOT activity/content or secondary: this is the page's entry point for DOING something, and activity/content render BELOW the content it acts on — an action bar placed after the work is an action bar the user finds too late. The one-third column also wraps a row of buttons into several cramped lines.",
      "events": [
        "actionTrigger"
      ],
      "bindingSchema": {
        "required": [],
        "optional": [],
        "note": "不使用 binding；入口按钮由 actions[] 里的 createRecord/navigate 类型动作声明。"
      }
    },
    {
      "type": "FilterBar",
      "description": "时间范围和枚举条件筛选栏，适合经营大盘、舆情监控等需要全局筛选的页面顶部。",
      "rendererKey": "filter-bar",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "showDateRange": {
            "type": "boolean"
          }
        }
      },
      "dataKinds": [
        "aggregate"
      ],
      "allowedSlots": [
        "summary"
      ],
      "slotsRationale": "summary ONLY: a filter must sit BEFORE the rows it filters. Every other slot renders after summary, so putting it anywhere else asks the user to read the content first and filter it afterwards.",
      "events": [
        "filterChange"
      ],
      "bindingSchema": {
        "required": [],
        "optional": [
          "entityRef"
        ],
        "note": "可筛选字段在 props.filterFields 里声明（不是 binding）；entityRef 仅在需要按实体过滤时填写。触发 changeFilter 动作刷新同页面其他区块。"
      }
    },
    {
      "type": "WorkflowTimeline",
      "description": "横向连接的流程阶段条，把 workflow 系统的节点顺序可视化。",
      "rendererKey": "workflow-timeline",
      "rendererStatus": "real",
      "generationEnabled": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "chainRef": {
            "type": "string"
          }
        }
      },
      "dataKinds": [],
      "allowedSlots": [
        "primary",
        "content",
        "activity"
      ],
      "slotsRationale": "NOT secondary or summary: this bar runs HORIZONTALLY across its stages, so the one-third-width side column squeezes it unreadable, and the top wrapping row is a strip for compact controls, not for a full stage bar. It needs the wide main column or a full-width row.",
      "events": [
        "itemSelect"
      ],
      "bindingSchema": {
        "required": [],
        "optional": [],
        "note": "不使用 binding；展示哪条流程链路由 props.chainRef 声明（留空=workflow 主链路，填值必须是 workflow.chains[].id 之一）。节点、顺序、条件全部从 workflow 系统机械派生，不接受自由文案。"
      }
    },
    {
      "type": "FreeformInsight",
      "description": "AI 自由设计的洞察卡片——结构和样式由二段生成按 designBrief 现场设计，不是固定模板；数字/统计类内容必须挂 dataRef 指向真实数据，编不出来的不画。",
      "rendererKey": "freeform-insight",
      "rendererStatus": "real",
      "generationEnabled": false,
      "freeformGenerated": true,
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "designBrief": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "dataKinds": [],
      "allowedSlots": [
        "primary",
        "secondary",
        "content",
        "activity"
      ],
      "slotsRationale": "NOT summary: a designed insight card is a block of content, not a compact control that fits the top wrapping strip.",
      "events": [],
      "bindingSchema": {
        "required": [],
        "optional": [],
        "note": "不使用 binding；本次调用只需要给 props.designBrief（一句话说清楚这个区块该展示什么，必填，不能空），具体结构/样式/数据绑定由二段生成流程另外产出，不在这次输出里。"
      }
    }
  ]
}
