      "pageKinds": [
        "workbench",
        "dashboard",
        "monitor"
      ],
      "allowedSlots": [
        "primary",
        "secondary"
      ],
      "slotsRationale": "NOT summary or activity/content: a Top-N is a vertical list and needs column height, which the top wrapping row has none of.",
