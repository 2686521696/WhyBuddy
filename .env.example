# ============================================================
# SlideRule — 环境配置
#   cp .env.example .env   然后填值（.env 已被 .gitignore 排除，永不提交）
#
# 只列一键部署与推演主线真正用到的配置；其余高级开关都有安全默认值，
# 需要时查 docs/ 与代码内注释（历史完整清单见 git 历史中的本文件旧版）。
# 任何真实 key 都不要写进本文件——它是要提交进仓库的模板。
# ============================================================

# ── LLM（核心配置）──────────────────────────────────────────
# 任意 OpenAI 兼容供应商（OpenAI / Azure / DashScope / OpenRouter /
# SiliconFlow / Moonshot / 智谱 …）。不填也能启动，但推演走确定性
# 模板回退，看不到真实 LLM 推演。
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.5

# 线控与手感（下面是长期实跑验证过的一组；按你的网关实测调整）
LLM_WIRE_API=chat_completions
LLM_STREAM=false
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_MS=600000
LLM_ROUTER_TIMEOUT_MS=600000
# 免输出截断保护的模型白名单（逗号分隔）
LLM_UNLIMITED_MODELS=gpt-5.5

# 你的路由没有 /embeddings 端点时保持 false（避免无谓的 404 请求）；
# 有 embedding 模型可改 true 启用语义向量检索
RAG_VECTOR_ENABLED=false

# 新颖意图由 LLM 生成五系统元模型（经结构门校验，fail-closed）
SLIDERULE_LLM_GENERATE_ENABLED=1

# 通道支持图片输入（多模态 content parts）时置 1：图片附件走视觉 LLM
# 提取内容注入推演。不支持的通道保持 0——附件解析会如实降级为只带文件名
LLM_SUPPORTS_IMAGE_CONTENT_PARTS=1

# ── 会话签名 ────────────────────────────────────────────────
# 生产环境换成 64 位随机 hex；本地开发任意非空值即可
SESSION_SECRET=replace_with_a_64_char_random_hex_secret

# ── 可选：evidence.search 全网检索 ──────────────────────────
# SerpAPI 兼容端点的 key；不填走 DuckDuckGo 回退，再不行如实降级
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_API_URL=https://serpapi.com/search.json

# ── 可选：E2B 沙盒（code.run 执行工具 + 应用中心真实缩略图截图）────
# 填了 key 工具即可用；不填 fail-closed（工具自动不可用，不假装）。
# key 从 https://e2b.dev → Dashboard → API Keys 获取。
# E2B_API_KEY=
# 应用中心真实截图额外需要这个：本应用自身的公网可达地址（E2B 沙盒是独立
# 云端机器，够不到宿主 localhost）。留空则截图功能不可用，前端如实回退占位
# 卡，不会报错也不会假装成功。
# SLIDERULE_PUBLIC_APP_URL=https://your-deployed-domain.example.com
# 截图沙盒的自定义 E2B 模板名（可选，强烈推荐）：用 e2b CLI 把
# playwright+chromium 预先烤进模板后填这里，截图沙盒秒级启动；不填则每个
# 一次性沙盒现装（实测 29.1s/次）。做法同 AGENTSHIRE_E2B_TEMPLATE 先例。
# SLIDERULE_E2B_TEMPLATE=
# 说明：应用中心卡片的缩略图**不走这条路**。卡片有三级来源，靠前的更可信：
#   ① 真截图 —— 前端在活渲染那张卡上就地采集后回传（零配置、零基础设施，
#                见 client/src/lib/thumb-capture.ts）
#   ② 参照板 —— 生成时给设计 LLM 排版式用的示意图，落库即有
#   ③ 活渲染 —— 前两级都没有时的兜底
# 上面这两个 E2B 变量只服务于 /sessions/{id}/screenshot 这个按需截图接口，
# 与卡片缩略图无关。

# ── 可选：生图（体验层的身份主题取色 + 版式参照）──────────────
# 任意 OpenAI 兼容的 images 端点。三项必须齐全，缺一项生图整体不可用。
# 不填不会报错：身份主题回落 8 套预设、FreeformInsight 退化为纯文字生成
# （fail-open，绝不拦闭环）——但那条"照着生成的参照图取色"的链路就没了，
# 各个应用的视觉会明显趋同。想看体验层的完整效果就把它配上。
# 注意 IMAGE_API_URL 要填【完整端点】而不是 base，客户端直接 POST 这个
# 地址、不会自己拼 /images/generations 路径。
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=gpt-image-1
# IMAGE_API_KEY=
# 单次生图超时（秒），默认 600。生图普遍慢，实测一张 30~60s 很常见。
# IMAGE_TIMEOUT_S=600

# ── 可选：首页参照板单独走另一家服务商 ─────────────────────────
# 只影响 enrich_monitor_page_overviews 那张首页参照板，其余生图不变。
# 三项配齐才启用，缺任意一项自动回落上面那份，行为与不配时逐字节一致。
#
# 为什么会有这个口子：实测过不同服务商的像素档位差很多（量到过一家出
# 3584x2048≈7.3MP，而当前这家同一 prompt 传 3840x2160 也只回 1672x941≈1.6MP，
# 耗时 85s vs 90s 几乎无差）。参照图的清晰度直接决定设计 LLM 能学到多少版式
# 细节，而首页那张是目前唯一驱动版式的图（FreeformInsight 未放开，单区块参照
# 图只在首页那张失败时兜底），所以口子开在这一处收益最大、改动面最小。
# SHEET_IMAGE_API_URL=
# SHEET_IMAGE_MODEL=
# SHEET_IMAGE_API_KEY=
# 尺寸/请求体形态：不同服务商字段名不一样，传错不报错、只会拿到默认档位的图。
#   size 形态（OpenAI 标准）  ：SHEET_IMAGE_BODY_STYLE=size,       SHEET_IMAGE_SIZE=1792x1024
#   image_size 形态（另一类）：SHEET_IMAGE_BODY_STYLE=image_size, SHEET_IMAGE_SIZE=2K
# SHEET_IMAGE_BODY_STYLE=size
# SHEET_IMAGE_SIZE=
# SHEET_IMAGE_ASPECT_RATIO=16:9
# SHEET_IMAGE_TIMEOUT_S=600

# 体验层成本预算（可选）：每次增强最多生成几张视觉参考图 / 跑几次截图自检。
# 超预算的区块退化为纯文字生成（有日志，不静默）。默认 4 / 2；设 0 全关。
# SLIDERULE_ENRICH_MAX_REF_IMAGES=4
# SLIDERULE_ENRICH_MAX_SCREENSHOT_VERIFY=2

# ── 可选：生产部署的镜像源（仅 docker-compose.prod.yml 用到）──
# 国内服务器拉 ghcr 慢时三选一（详见 docker-compose.prod.yml 头部注释）：
# SLIDERULE_REGISTRY=ghcr.nju.edu.cn
# SLIDERULE_IMAGE_APP=docker.io/xiaoji68686/whybuddy-app:latest
# SLIDERULE_IMAGE_PYTHON=docker.io/xiaoji68686/whybuddy-python:latest

# ── 可选：账号功能（登录/邮箱验证码/projects）────────────────
# 推演主线不需要数据库。需要账号功能时：
#   docker compose --profile accounts up -d
# 本地非 Docker 环境自行准备 MySQL 并解开下面注释。
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=sliderule
# DB_USER=root
# DB_PASSWORD=change_me

# ── 可选：生成应用存储 / App Store（推演出来的应用持久化 → 组建库地基）──
# 填了连接串就把每个生成的应用（设计层：五系统模型+appbundle+主题+freeform）
# 存进托管 Postgres，能查询/索引/并发、能列出历史应用/重开/fork/看改版史；
# 不填就 fail-open 回退本地 JSON 文件（data/sliderule-generated-apps.json），
# 行为跟"没有 DB"完全一致。抽象层可换：Neon / Supabase / 自建 PG 只改这一行。
# Neon（serverless Postgres，.env 填连接串即通，自带 pgvector 供后续组建库）：
#   从 neon.tech → 项目 → Connection string 拷贝，形如：
# APP_STORE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
# 也接受本地 SQLite（比 JSON 文件强、无需托管服务）：
# APP_STORE_DATABASE_URL=sqlite:///data/apps.db
#
# 降级优先级（2026-07-28 起，四级 fail-open）：
#   远端 TCP → 远端 SQL over HTTP → 本地 SQLite → 本地 JSON 文件
#   └────── 同一个 APP_STORE_DATABASE_URL ──────┘
# 前两级是同一个远端库的两条通道（受限网络只放行 443 时自动改走 HTTP，
# 数据不分叉）；远端整个不可用才落本地 SQLite，本地库也建不起来才回 JSON。
#
# ⚠️ 从第 3 级开始数据与远端分叉：远端恢复后本地这段时间的记录不会自动回流，
# 需要人工导出/合并。降级时日志会打印"现在写在哪"。
#
# 本地 SQLite 档的路径（默认如下）。置空则跳过这一级、直接用 JSON——
# 只读文件系统或不想在磁盘上留库文件时用得上：
# APP_STORE_LOCAL_SQLITE=sqlite:///data/sliderule-apps.db
